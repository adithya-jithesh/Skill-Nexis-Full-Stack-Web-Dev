# Copy this file to .env and fill in your own values.

PORT=5006

# Local MongoDB. In production this is the MongoDB Atlas connection string,
# set in the host's environment rather than in a file.
MONGODB_URI=mongodb://127.0.0.1:27017/social_feed

# Which origins may call this API, comma separated. In production this is the
# deployed front end, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5176

# Signs the JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Left unset locally, so errors come back with a stack trace to debug from.
# On the host this MUST be "production" - that is what withholds the stack
# trace from the response. Hosts do not all set it for you.
# NODE_ENV=production

# Where uploaded images are written. Left unset it is ./uploads; on a host
# with a mounted disk, point it at that disk.
# UPLOAD_DIR=/var/data/uploads
