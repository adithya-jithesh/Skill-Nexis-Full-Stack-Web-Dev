# Copy this file to .env and fill in your own values.

PORT=5005

# Local MongoDB. For Atlas, paste the connection string from the dashboard.
MONGODB_URI=mongodb://127.0.0.1:27017/task_manager

# Where the React client runs. Only this origin is allowed to call the API.
CLIENT_URL=http://localhost:5175

# Signs the JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
