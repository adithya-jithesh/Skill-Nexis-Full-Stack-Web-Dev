      "key": "baseUrl",
      "value": "http://localhost:5003"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    }
  ],
