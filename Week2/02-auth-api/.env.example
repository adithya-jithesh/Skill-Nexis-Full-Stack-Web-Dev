# Copy this file to .env and fill in your own values.

PORT=5001

# Local MongoDB. For Atlas, paste the connection string from the dashboard.
MONGODB_URI=mongodb://127.0.0.1:27017/auth_api

# The secret used to sign JWTs. Anyone holding this can forge a token, so a
# real deployment needs a long random value that is never committed.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
