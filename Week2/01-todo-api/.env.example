# Copy this file to .env and fill in your own values.

# Where the API listens.
PORT=5000

# Local MongoDB (the default when MongoDB is installed on your machine).
# For MongoDB Atlas, paste the connection string from the Atlas dashboard:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo_api
MONGODB_URI=mongodb://127.0.0.1:27017/todo_api
